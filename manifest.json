{
  "manifest_version": 3,
  "name": "UnLikeIt",
  "version": "1.0.0",
  "description": "Take back your privacy. The ultimate easy-to-use tool to wipe your Instagram history and manage followers.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["unlikeit.js"],
      "run_at": "document_idle"
    }
  ]
}
